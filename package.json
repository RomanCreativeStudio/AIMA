{
  "name": "aima",
  "private": true,
  "version": "0.1.0",
  "description": "AIMA — personal AI operating assistant. Monorepo root.",
  "workspaces": [
    "ai-engine",
    "backend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs:validate": "node scripts/validate-docs.js",
    "db:migrate": "bash database/apply-migrations.sh",
    "db:backup": "bash database/backup.sh",
    "db:restore": "bash database/restore.sh",
    "smoke-test": "node scripts/smoke-test.js"
  }
}
