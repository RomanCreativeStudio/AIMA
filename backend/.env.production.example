# Production environment template (Phase 3.1, docs/PRODUCTION_SETUP.md).
# Copy to .env, fill in real values from your host/secret manager. Never
# commit a filled-in .env — this file holds shapes and placeholders only.

PORT=4000
NODE_ENV=production

# Comma-separated list of allowed browser origins. Leave empty to deny all
# cross-origin requests — do not use "*" in production.
CORS_ORIGINS=https://app.example.com

# Managed Postgres connection string. Most managed providers (Supabase,
# Render, Fly Postgres) require DATABASE_SSL=true.
DATABASE_URL=postgresql://user:password@db-host:5432/aima_production
DATABASE_SSL=true
DATABASE_POOL_MAX=10

AI_PROVIDER=claude
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Must be a base64-encoded 32-byte key — generate with `openssl rand -base64 32`.
# Store this in your secret manager, not in plain environment variables where avoidable.
CREDENTIAL_ENCRYPTION_KEY=

# Must be an https:// URL in production — loadConfig() enforces this since
# OAuth providers redirect real users here with authorization codes.
PUBLIC_BACKEND_URL=https://api.example.com

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Voice providers (Phase 3.3) — "mock" needs no credentials; "openai" uses
# OpenAI's Whisper/TTS REST APIs and requires an API key.
SPEECH_TO_TEXT_PROVIDER=openai
SPEECH_TO_TEXT_PROVIDER_API_KEY=
TEXT_TO_SPEECH_PROVIDER=openai
TEXT_TO_SPEECH_PROVIDER_API_KEY=
