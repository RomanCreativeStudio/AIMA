# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (e.g. the web dashboard).
# Leave empty to deny all cross-origin requests.
CORS_ORIGINS=http://localhost:3000

# Database (docs/DEVELOPMENT_SETUP.md §6) — local Postgres or your managed provider.
DATABASE_URL=postgresql://aima:aima@localhost:5432/aima_dev

# Set to "true" for managed Postgres providers that require TLS (Phase 3.1,
# docs/PRODUCTION_SETUP.md). Leave unset for a local, non-TLS Postgres.
DATABASE_SSL=false
# Max simultaneous pool connections.
DATABASE_POOL_MAX=10

# AI provider selection — shared convention with ai-engine/.env.example.
# Supported values: "claude" | "mock". Defaults to "mock" so the backend runs
# without any provider credentials.
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Embedding provider selection (memory/knowledge/semantic retrieval) — read
# directly by this backend process (backend/src/index.ts), not just ai-engine's
# own package; also documented in ai-engine/.env.example for that package's
# own standalone use. Supported values: "mock" | "openai". Defaults to "mock".
EMBEDDING_PROVIDER=mock
EMBEDDING_PROVIDER_API_KEY=
EMBEDDING_PROVIDER_MODEL=

# Authentication provider (EPIC-004, docs/decisions/0022-authentication-architecture.md).
# Supported values: "mock" | "supabase". Defaults to "mock" — a deterministic,
# no-network-call test double (its "password" is derivable from the email
# address alone) that is fine for local development but MUST NOT run in
# production; loadConfig() (backend/src/config/env.ts) refuses to start in
# production unless this is explicitly set to "supabase".
AUTH_PROVIDER=mock
# Required when AUTH_PROVIDER=supabase — your Supabase project URL and its
# anon/publishable API key (safe to use here; this key alone grants no table
# access — see docs/decisions/0024-database-security-boundary.md).
AUTH_PROVIDER_URL=
AUTH_PROVIDER_API_KEY=

# Auth rate limiting (docs/decisions/0023-authentication-rate-limiting.md) —
# all optional, shown here with their built-in defaults. Override only if you
# have a specific reason to; the defaults are production-safe as-is.
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_IP_RATE_LIMIT_MAX=20
AUTH_LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000

# Encrypts integration credentials at rest (Phase 2.3, backend/src/integrations/
# encryption.ts). Must be a base64-encoded 32-byte key — generate one with:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Live Integration Providers (Phase 2.7, docs/decisions/0015-live-integration-providers.md).
# This backend's own reachable URL — OAuth providers redirect here after consent.
PUBLIC_BACKEND_URL=http://127.0.0.1:4000

# Google OAuth app (covers both Gmail and Calendar) — register at
# https://console.cloud.google.com/apis/credentials, with an authorized
# redirect URI of {PUBLIC_BACKEND_URL}/api/oauth/gmail/callback and
# {PUBLIC_BACKEND_URL}/api/oauth/calendar/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth app — register at https://github.com/settings/developers,
# with an authorization callback URL of {PUBLIC_BACKEND_URL}/api/oauth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Voice Assistant Foundation (Phase 3.2) / Real Voice Provider Integration
# (Phase 3.3, docs/decisions/0018-real-voice-provider-integration.md).
# Supported values: "mock" | "openai". Defaults to "mock" so the backend runs
# without any voice vendor credentials. "openai" uses OpenAI's Whisper
# (speech-to-text) and TTS (text-to-speech) REST APIs.
SPEECH_TO_TEXT_PROVIDER=mock
SPEECH_TO_TEXT_PROVIDER_API_KEY=
SPEECH_TO_TEXT_PROVIDER_MODEL=
SPEECH_TO_TEXT_PROVIDER_TIMEOUT_MS=

TEXT_TO_SPEECH_PROVIDER=mock
TEXT_TO_SPEECH_PROVIDER_API_KEY=
TEXT_TO_SPEECH_PROVIDER_MODEL=
TEXT_TO_SPEECH_PROVIDER_TIMEOUT_MS=

# Internal Operator Dashboard (founder/admin view). Comma-separated users.id
# values allowed to call /api/admin/*. Empty by default — no admin surface
# is reachable until this is set (docs/decisions — requireAdmin middleware).
ADMIN_USER_IDS=

# Beta Invitations & Notifications sprint. Optional webhook URL POSTed a JSON
# payload ({event: "invitation.created", invitation}) whenever a founder
# creates an invitation via POST /api/admin/invitations. Unset by default —
# invitation creation works identically with no notification sent. Webhook
# failures are logged only and never fail the invitation (WebhookNotificationService).
WEBHOOK_URL=
