# AI provider selection — must never be hardcoded elsewhere in the codebase.
# Supported values: "claude" | "mock"
AI_PROVIDER=mock

# Required when AI_PROVIDER=claude. Never commit a real value.
AI_PROVIDER_API_KEY=

# Optional: override the default model for the selected provider.
AI_PROVIDER_MODEL=

# Embedding provider selection (memory & knowledge retrieval — Intelligence Sprint).
# Supported values: "mock" | "openai"
EMBEDDING_PROVIDER=mock

# Required when EMBEDDING_PROVIDER=openai. Never commit a real value.
EMBEDDING_PROVIDER_API_KEY=

# Optional: override the default embedding model (default: text-embedding-3-small).
EMBEDDING_PROVIDER_MODEL=

# Voice Assistant Foundation provider selection (Phase 3.2).
# Supported values: "mock" (only one today — no vendor lock-in).
SPEECH_TO_TEXT_PROVIDER=mock
TEXT_TO_SPEECH_PROVIDER=mock
